# Get a free key at https://aistudio.google.com/apikey  (leave empty for Demo mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Firestore: path to a Firebase service-account JSON (leave empty for in-memory)
FIREBASE_SERVICE_ACCOUNT=
# Demo clock: food spoils this many times faster than real time so judges can watch it drain
DEMO_SPEED=30
PORT=3000
